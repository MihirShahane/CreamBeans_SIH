# Supabase project credentials.
# Leave both unset (or USE_IN_MEMORY_DB=true) to run the backend locally
# against an in-process in-memory database — useful for development and
# for running the test suite without a live Supabase project.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=item-images

# Explicitly force the in-memory dev database on/off. If unset, defaults
# to true when Supabase credentials above are missing.
USE_IN_MEMORY_DB=

# Max number of active found/lost items considered as match candidates
# per matching call.
MAX_MATCH_CANDIDATES=200

# Comma-separated list of allowed CORS origins, or "*" for all (dev only).
CORS_ORIGINS=*

ENV=development
